#!/usr/bin/env php
<?php

use DTL\OapiScg\Generator;

require __DIR__ . '/../vendor/autoload.php';

ini_set('error_reporting', E_ALL & ~E_DEPRECATED);

$opts = getopt('n:', [], $stop);
$namespace = isset($opts['n']) ? $opts['n'] : '';

$argv = array_slice($argv, $stop);
$file = array_shift($argv);
$outPath = array_shift($argv);
$names = $argv ?: [];

if ($file === null) {
    stderr('No file provided');
    exit(1);
}
if ($outPath === null) {
    stderr('No outpath provided');
    exit(1);
}

$generator = Generator::new($file, $outPath, namespace: $namespace);

foreach ($generator->generate(...$names) as $report) {
    stderr(sprintf('Written %d to %s', $report->written, $report->path));
}

function stdout(string $message): void
{
    fwrite(STDOUT, $message . "\n");
}

function stderr(string $message): void
{
    fwrite(STDERR, $message . "\n");
}

#!/usr/bin/env php
<?php

use DTL\OapiScg\Builder;
use DTL\OapiScg\ClassGenerator;
use DTL\OapiScg\SchemaFinder;
use PhpParser\PrettyPrinter;
use PhpParser\PrettyPrinter\Standard;

require __DIR__ . '/../vendor/autoload.php';

ini_set('error_reporting', E_ALL & ~E_DEPRECATED);


array_shift($argv);
$file = array_shift($argv);
$names = $argv ?? [];

if ($file === null) {
    stderr('No file provided');
    exit(1);
}

$finder = SchemaFinder::fromJsonSpec(realpath($file));


$printer = new Standard();
foreach ((new Builder($finder, '', objectAsArray: true))->generate(...$names) as $model) {
    $ast = (new ClassGenerator())->generate($model);
    stdout($printer->prettyPrintFile($ast->stmts));
}

function stdout(string $message): void
{
    fwrite(STDOUT, $message . "\n");
}

function stderr(string $message): void
{
    fwrite(STDERR, $message . "\n");
}

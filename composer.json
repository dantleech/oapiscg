{
    "name": "dtl/oapiscg",
    "description": "Open API Selective Code Generator",
    "type": "library",
    "require": {
        "nikic/php-parser": "^5.8",
        "cebe/php-openapi": "^1.8",
        "symfony/console": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "carthage-software/mago": "^1.46",
        "symfony/var-dumper": "^8.1",
        "symfony/filesystem": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "DTL\\OapiScg\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DTL\\OapiScg\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "integrate": [
            "mago lint --fix -unsafe",
            "mago analyse --unsafe"
        ]
    },
    "authors": [
        {
            "name": "Dan",
            "email": "dan@dtlsoftware.co.uk"
        }
    ]
}
